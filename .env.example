DATABASE_URL=postgresql+psycopg://pipeline:pipeline@db:5432/air_quality
LOCATION_ID=bengaluru
LATITUDE=12.9716
LONGITUDE=77.5946
SOURCE=open-meteo-cams
# First run backfills this many days; later runs fetch only what is new (plus OVERLAP_HOURS).
BACKFILL_DAYS=90
OVERLAP_HOURS=48
SCHEDULE_MINUTES=60
RETRAIN_INTERVAL_HOURS=168
TRAIN_RETRY_MINUTES=60
RAW_RETENTION_DAYS=30
API_PORT=8000

# Data-quality thresholds. These are proposals: calibrate them with
#   docker compose run --rm scheduler python scripts/calibrate_quality.py
# after about two weeks of data, then update the ceilings.
PM25_CEILING=1000
PM10_CEILING=1500
MAX_NULL_SHARE=0.01
GAP_WARN_HOURS=2
GAP_FAIL_HOURS=6
FRESHNESS_INTERVALS=2
VOLUME_MIN_SHARE=0.8
VOLUME_MAX_SHARE=1.1

# Optional Slack/Teams/Discord-compatible webhook. Called on failed or quarantined runs and
# on quality warnings. Never commit a real URL.
FAILURE_WEBHOOK_URL=
